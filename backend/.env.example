# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-in-production
PORT=5000

# Supabase (service role — NEVER expose to frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# CORS
FRONTEND_URL=http://localhost:5173

# Rate limiting
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URL=memory://

# Notifications (DMode — leave blank to use Demo mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ML
ML_MODEL_PATH=ml/models/best_model.joblib
RANDOM_SEED=42
